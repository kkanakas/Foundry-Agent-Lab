# Azure AI Foundry project endpoint (required)
PROJECT_ENDPOINT=https://your-resource.ai.azure.com/api/projects/your-project

# Model deployment to use (optional, defaults to model-router)
MODEL_DEPLOYMENT=model-router

# Agent name registered in Foundry (optional)
AGENT_NAME=MCP-Agent

# MCP server URL (the remote MCP server endpoint)
MCP_SERVER_URL=https://api.githubcopilot.com/mcp

# MCP server label (unique identifier for this MCP server)
MCP_SERVER_LABEL=github

# Project connection ID storing MCP server auth credentials
MCP_CONNECTION_NAME=my-github-mcp-connection
